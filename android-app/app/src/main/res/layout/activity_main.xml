<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera live preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- CV overlay on top of preview -->
    <com.cv.bowling.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/previewView"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Score panel top-right -->
    <LinearLayout
        android:id="@+id/scorePanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#CC000000"
        android:padding="10dp"
        android:layout_margin="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:id="@+id/scoreTitleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCORE"
            android:textColor="#00BCD4"
            android:textSize="11sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/scoreValueText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"/>
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="READY"
            android:textColor="#4CAF50"
            android:textSize="10sp"/>
    </LinearLayout>

    <!-- FPS top-left -->
    <TextView
        android:id="@+id/fpsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 FPS"
        android:textColor="#AAFFFFFF"
        android:textSize="11sp"
        android:background="#88000000"
        android:padding="4dp"
        android:layout_margin="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Bottom controls -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="10dp"
        android:background="#EE000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Row 1: Live camera controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnReset"
                android:layout_width="100dp"
                android:layout_height="44dp"
                android:text="RESET"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#555555"
                android:layout_marginEnd="10dp"/>

            <Button
                android:id="@+id/btnStart"
                android:layout_width="140dp"
                android:layout_height="44dp"
                android:text="▶ LIVE CAM"
                android:textSize="12sp"
                android:textStyle="bold"
                android:backgroundTint="#1565C0"/>

        </LinearLayout>

        <!-- Row 2: Upload video button -->
        <Button
            android:id="@+id/btnUploadVideo"
            android:layout_width="260dp"
            android:layout_height="44dp"
            android:text="📁 UPLOAD VIDEO"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#00796B"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
